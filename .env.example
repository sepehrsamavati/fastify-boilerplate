# Server
NODE_ENV=development
FAPI_API_SERVER_PORT=3017
FAPI_API_SERVER_BASE_ADDRESS=http://localhost:3017
FAPI_API_SERVER_COOKIE_SIGN_SECRET=change-me-to-a-long-random-secret

# Optional — first user with this username becomes admin
# FAPI_BOOTSTRAP_ADMIN_USERNAME=admin

# Storage
FAPI_STORAGE_BASE_PATH=./data/cache

# Auth cookie / token settings (optional)
# FAPI_ACCESS_TOKEN_COOKIE_KEY=access_token
# FAPI_REFRESH_TOKEN_COOKIE_KEY=refresh_token
# FAPI_ACCESS_TOKEN_MAX_AGE_SECONDS=900
# FAPI_REFRESH_TOKEN_MAX_AGE_SECONDS=5184000
# FAPI_ACCESS_TOKEN_EXPIRES_IN=15m
# FAPI_REFRESH_TOKEN_EXPIRES_IN=60d
# FAPI_REFRESH_TOKEN_PATH=/api/v1/auth/refresh

# API paths (optional)
# FAPI_API_V1_BASE_ADDRESS=/api/v1
# FAPI_TEMP_FILE_PATH=tempFile

# WebSocket (optional)
# FAPI_WS_MAX_CONNECTIONS_PER_USER=5

# Corporate HTTP proxy (optional)
# FAPI_HTTP_PROXY=http://proxy.example.com:8080
